# templates/python/template/{{ project_slug }}/pyproject.toml.jinja
[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
requires-python = ">={{ python_version }}"
dependencies = [
  {% if has_cli %}
  "typer>=0.9.0",
  {% endif %}
]

{% if has_cli %}
[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli:main"
{% endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 120
target-version = "py{{ python_version | replace('.', '') }}"

[tool.pytest.ini_options]
testpaths = ["tests"]
